{
  "name": "react-native-animateable-text-example",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "cd ../ && yalc publish && cd example && expo prebuild --clean && yarn",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "generatecpp": "node node_modules/react-native/scripts/generate-codegen-artifacts.js -p ../ -o ../gcpp -t all"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@miblanchard/react-native-slider": "^2.6.0",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-animateable-text": "file:.yalc/react-native-animateable-text",
    "react-native-reanimated": "4.7.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.3.0",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "typescript": "~6.0.3",
    "yalc": "^1.0.0-pre.53"
  },
  "private": true,
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
